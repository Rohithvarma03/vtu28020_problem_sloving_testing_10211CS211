import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int m = sc.nextInt();
        int n = sc.nextInt();
        int r = sc.nextInt();
        int[][] mat = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                mat[i][j] = sc.nextInt();
            }
        }

        int layers = Math.min(m, n) / 2;
        for (int layer = 0; layer < layers; layer++) {
            List<Integer> elems = new ArrayList<>();

            // extract
            for (int j = layer; j < n - layer; j++) elems.add(mat[layer][j]);
            for (int i = layer + 1; i < m - layer - 1; i++) elems.add(mat[i][n - layer - 1]);
            for (int j = n - layer - 1; j >= layer; j--) elems.add(mat[m - layer - 1][j]);
            for (int i = m - layer - 2; i > layer; i--) elems.add(mat[i][layer]);

            int len = elems.size();
            int rot = r % len;

            // rotate
            List<Integer> rotated = new ArrayList<>();
            rotated.addAll(elems.subList(rot, len));
            rotated.addAll(elems.subList(0, rot));

            // put back
            int idx = 0;
            for (int j = layer; j < n - layer; j++) mat[layer][j] = rotated.get(idx++);
            for (int i = layer + 1; i < m - layer - 1; i++) mat[i][n - layer - 1] = rotated.get(idx++);
            for (int j = n - layer - 1; j >= layer; j--) mat[m - layer - 1][j] = rotated.get(idx++);
            for (int i = m - layer - 2; i > layer; i--) mat[i][layer] = rotated.get(idx++);
        }

        // print result
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(mat[i][j] + " ");
            }
            System.out.println();
        }
    }
}
